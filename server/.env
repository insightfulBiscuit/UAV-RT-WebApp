# DJI FlightHub 2 credentials
# Base URL of your FlightHub 2 deployment (public cloud or on-prem).
# On-prem example: http://127.0.0.1:30812
# Public cloud example: https://fh.dji.com
FH2_BASE_URL=es-flight-api-us.djigate.com

# Organization key from FlightHub 2 -> My Organization -> Organization Settings -> FlightHub Sync -> Organization Key
FH2_USER_TOKEN=eyJhbGciOiJIUzUxMiIsImNyaXQiOlsidHlwIiwiYWxnIiwia2lkIl0sImtpZCI6IjBkNzQyMzFmLTgxOWYtNDE3NS04NWUzLTRhZDQxODUzMzEyZiIsInR5cCI6IkpXVCJ9.eyJhY2NvdW50IjoiIiwiZXhwIjoyMDk2MjE0MDYzLCJuYmYiOjE3ODA1OTQ4NjMsIm9yZ2FuaXphdGlvbl91dWlkIjoiOGEwZGZhMTctODQ5My00YjU0LTg2NWItMGZlMzNjMzAxOWZiIiwicHJvamVjdF91dWlkIjoiIiwic3ViIjoiZmgyIiwidXNlcl9pZCI6IjIwNjI1ODg0OTc4OTc0MjI4NDgifQ.6EUZftj0K7GkAjY1nxW2jor9tMAX1PCHSp4Q4NMgfQgXxHV4MzTpj33lMob9JL9oUNa11K0-ztr9zu_qXSnZbA

# Project UUID (from GET /openapi/v0.1/project, look at data.list[].uuid)
FH2_PROJECT_UUID=f4a8c792-2274-4134-9170-0e48a2727901

# Optional: language for FlightHub responses (en | zh)
FH2_LANGUAGE=en

# Port this Express API listens on
PORT=4000

# ---- MQTT (for real-time thermal spot metering) ----
# Broker your FlightHub Sync is configured to publish to. Examples:
#   mqtts://xxxxxxx.emqxsl.com:8883    (EMQX Cloud with TLS)
#   mqtt://localhost:1883              (self-hosted Mosquitto)
# Leave blank to disable MQTT features (thermal falls back to color approximation).
MQTT_BROKER_URL=d769c1e7.ala.dedicated.aws.emqxcloud.com
MQTT_USERNAME=kelowna
MQTT_PASSWORD=drone
MQTT_CLIENT_ID=Kelowna-UAV-RT

# Dock 3 SN — the MQTT gateway that forwards to your M4TD.
MQTT_DOCK_SN=8UUXP3800A10MS

# --- MediaMTX / WHEP config (added for Volcengine removal) ---
# Where FH2 tells the dock to push RTMP. Composed as {base}/{streamKey}.
RTMP_PUSH_URL_BASE=rtmp://localhost:1935/live
# What the browser hits for WHEP playback. Composed as {base}/{streamKey}/whep.
WHEP_PLAYBACK_URL_BASE=http://localhost:8889/live
# Where the AI ffmpeg frame tap pulls from (defaults to RTMP_PUSH_URL_BASE).
# RTMP_PLAYBACK_URL_BASE=rtmp://localhost:1935/live
# FFMPEG_LOG=1

# --- Fixed Akamai stream (coworker's MediaMTX on 172.239.170.143) ---
# Our own local MediaMTX pulls from that RTMP source and re-publishes as WHEP.
AKAMAI_M400_WHEP_URL=http://localhost:8889/m400/whep
